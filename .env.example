# Resend API key, used by /api/send-custom-template-description to email
# custom-template requests. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Meta (Facebook) Pixel ID. When set, the pixel loads on every page and fires
# a "Lead" event whenever the custom-template / request-template form is
# submitted successfully. Find it in Events Manager > Data Sources > your pixel.
NEXT_PUBLIC_META_PIXEL_ID=
